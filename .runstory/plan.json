    ],
    "from": {
      "file": "apps/web/package.json",
      "line": 12,
      "text": "\"test\": \"vitest run\""
    },
    "state": "derived"
  },
  "start": {
    "command": [
      "corepack",
      "pnpm",
      "run",
      "runstory:start"
    ],
    "port": 3000,
    "health": "/health",
    "from": {
      "file": "apps/web/package.json",
      "line": 10,
      "text": "\"runstory:start\": \"bash ../../scripts/runstory/start.sh\""
